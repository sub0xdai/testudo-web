---
import Base from '../../layouts/Base.astro'
import Footer from '../../components/Footer.astro'
import { vsPages } from '../../content/vs/schema'
import type { VsPageData } from '../../content/vs/schema'

export function getStaticPaths() {
  return vsPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }))
}

interface Props {
  page: VsPageData
}

const { page } = Astro.props
const speedMultiplier = Math.round(page.speed.exchangeSeconds / page.speed.testudoSeconds)

const comparisonRows = [
  { feature: 'Risk-based sizing', exchange: page.sizing.hasCalculator ? 'Margin-based' : 'None', testudo: 'From stop distance' },
  { feature: 'Bracket orders', exchange: page.sizing.bracketOrders ? 'Yes' : 'Separate', testudo: 'Atomic' },
  { feature: 'TradingView execution', exchange: 'Manual', testudo: 'Alt+X' },
  { feature: 'Risk % enforcement', exchange: page.sizing.enforcesRiskPercent ? 'Yes' : 'No', testudo: 'Yes' },
  { feature: 'Auto journal + R-multiples', exchange: 'No', testudo: 'Yes' },
  { feature: 'High volatility', exchange: page.reliability.lagsDuringVolatility ? 'Lags' : 'Stable', testudo: 'Direct API' },
]
---

<Base title={page.title} description={page.metaDescription}>
  <main class="relative z-10 text-text-primary">

    <!-- Hero + Speed -->
    <section class="border-b border-container-border">
      <div class="max-w-4xl mx-auto px-6 md:px-12 py-16 md:py-20">
        <p class="font-mono text-[10px] tracking-widest text-text-tertiary mb-6 uppercase">
          TESTUDO VS {page.exchange.toUpperCase()}
        </p>
        <h1 class="font-mono text-2xl md:text-4xl font-bold tracking-tight mb-4">
          {page.headline}
        </h1>
        <p class="font-mono text-sm text-text-secondary mb-12 max-w-xl">
          {page.subheadline}
        </p>

        <!-- Speed callout -->
        <div class="grid grid-cols-3 gap-6 items-end mb-12">
          <div>
            <p class="font-mono text-3xl font-bold text-signal-red">~{page.speed.exchangeSeconds}s</p>
            <p class="font-mono text-[10px] text-text-tertiary mt-1">{page.exchange} · {page.speed.exchangeSteps} steps</p>
          </div>
          <div class="text-center">
            <p class="font-mono text-5xl font-bold text-text-primary">{speedMultiplier}x</p>
            <p class="font-mono text-[10px] text-text-tertiary mt-1">faster</p>
          </div>
          <div class="text-right">
            <p class="font-mono text-3xl font-bold text-signal-green">{page.speed.testudoSeconds}s</p>
            <p class="font-mono text-[10px] text-text-tertiary mt-1">Testudo · Alt+X</p>
          </div>
        </div>

        <!-- Comparison table -->
        <table class="w-full font-mono text-xs">
          <thead>
            <tr class="border-b border-container-border">
              <th class="text-left py-3 text-text-tertiary font-normal"></th>
              <th class="text-left py-3 text-text-tertiary font-normal">{page.exchange}</th>
              <th class="text-left py-3 text-text-tertiary font-normal">Testudo</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-b border-container-border/30">
                <td class="py-3 pr-4 text-text-secondary">{row.feature}</td>
                <td class="py-3 pr-4 text-text-tertiary">{row.exchange}</td>
                <td class="py-3 text-signal-green">{row.testudo}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- CTA + Related -->
    <section>
      <div class="max-w-4xl mx-auto px-6 md:px-12 py-16 text-center">
        <p class="font-mono text-xl md:text-2xl font-bold text-text-primary mb-3">
          Your chart. Your edge. Properly sized.
        </p>
        <p class="font-mono text-xs text-text-secondary mb-8">
          Use {page.exchange} as your exchange. Use Testudo as your execution layer.
        </p>
        <a
          href="https://desk.testudo.vip"
          class="inline-block border border-border-active text-text-primary font-mono text-xs tracking-wider px-8 py-3 hover:bg-text-primary hover:text-main-bg transition-colors"
        >
          {page.ctaText}
        </a>
        <p class="font-mono text-[10px] text-text-tertiary mt-3">
          $20/mo or $50 lifetime · No withdrawal permissions
        </p>

        <!-- Related -->
        <div class="flex flex-wrap justify-center gap-3 mt-12 pt-8 border-t border-container-border/30">
          {vsPages
            .filter((p) => p.slug !== page.slug)
            .map((p) => (
              <a
                href={`/vs/${p.slug}`}
                class="font-mono text-[10px] text-text-tertiary hover:text-text-primary border border-container-border/50 px-3 py-1.5 transition-colors"
              >
                vs {p.exchange}
              </a>
            ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
