---
import { getCollection } from 'astro:content'
import DocsLayout from '../../components/DocsLayout.astro'

const allDocs = await getCollection('docs')
const sorted = allDocs.sort((a, b) => a.data.order - b.data.order)

const traderDocs = sorted.filter(d => d.data.section === 'trader')
const technicalDocs = sorted.filter(d => d.data.section === 'technical')

const first = sorted[0]

// Minimal SVG icons per doc (index-based)
const icons: Record<string, string> = {
  '01-what-is-testudo': '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.5" fill="none"/>',
  '02-core-concepts': '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" stroke="currentColor" stroke-width="1.5" fill="none"/>',
  '03-getting-started': '<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/><polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="1.5" fill="none"/>',
  '04-extension': '<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 3v18" stroke="currentColor" stroke-width="1.5"/><path d="M13 8h4M13 12h4M13 16h2" stroke="currentColor" stroke-width="1.5"/>',
  '05-dashboard': '<path d="M18 20V10M12 20V4M6 20v-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  '06-journal': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5" fill="none"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5" fill="none"/>',
  '07-exchanges': '<polyline points="16 3 21 3 21 8" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="4" y1="20" x2="21" y2="3" stroke="currentColor" stroke-width="1.5"/><polyline points="21 16 21 21 16 21" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="15" y1="15" x2="21" y2="21" stroke="currentColor" stroke-width="1.5"/>',
  '08-faq': '<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="12" y1="17" x2="12.01" y2="17" stroke="currentColor" stroke-width="2"/>',
  '09-architecture': '<polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2" stroke="currentColor" stroke-width="1.5" fill="none"/>',
  '10-api-reference': '<polyline points="16 18 22 12 16 6" stroke="currentColor" stroke-width="1.5" fill="none"/><polyline points="8 6 2 12 8 18" stroke="currentColor" stroke-width="1.5" fill="none"/>',
}
---

<DocsLayout
  title="Documentation"
  description="Everything you need to know about trading with Testudo."
  next={first ? { slug: first.id, title: first.data.title } : undefined}
>
  <div class="space-y-12">
    {/* Quick start callout */}
    <a
      href="/docs/03-getting-started"
      class="block border border-text-primary/30 hover:border-text-primary p-5 transition-colors group"
    >
      <div class="flex items-center gap-3 mb-2">
        <svg width="18" height="18" viewBox="0 0 24 24" class="text-signal-green shrink-0">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="2" fill="none"/>
        </svg>
        <span class="font-mono text-sm font-bold text-text-primary group-hover:text-accent-steel transition-colors">
          Quick Start
        </span>
      </div>
      <p class="font-display text-xs text-text-secondary">
        Connect wallet, add exchanges, pair the extension, and place your first trade in under 5 minutes.
      </p>
    </a>

    {/* Trader docs — 2-column grid */}
    <section>
      <h2 class="font-mono text-[10px] tracking-widest uppercase text-text-tertiary mb-4">For Traders</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {traderDocs.map(doc => (
          <a
            href={`/docs/${doc.id}`}
            class="group flex gap-3 p-4 hover:bg-text-primary/[0.03] transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" class="text-text-tertiary group-hover:text-accent-steel transition-colors shrink-0 mt-0.5">
              <Fragment set:html={icons[doc.id] || ''} />
            </svg>
            <div>
              <h3 class="font-mono text-sm text-text-primary group-hover:text-accent-steel transition-colors mb-1">
                {doc.data.title}
              </h3>
              <p class="font-display text-xs text-text-tertiary leading-relaxed">
                {doc.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* Technical docs — 2-column grid */}
    {technicalDocs.length > 0 && (
      <section>
        <h2 class="font-mono text-[10px] tracking-widest uppercase text-text-tertiary mb-4">Technical</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {technicalDocs.map(doc => (
            <a
              href={`/docs/${doc.id}`}
              class="group flex gap-3 p-4 hover:bg-text-primary/[0.03] transition-colors"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" class="text-text-tertiary group-hover:text-accent-steel transition-colors shrink-0 mt-0.5">
                <Fragment set:html={icons[doc.id] || ''} />
              </svg>
              <div>
                <h3 class="font-mono text-sm text-text-primary group-hover:text-accent-steel transition-colors mb-1">
                  {doc.data.title}
                </h3>
                <p class="font-display text-xs text-text-tertiary leading-relaxed">
                  {doc.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</DocsLayout>
