---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../components/DocsLayout.astro'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  const sorted = docs.sort((a, b) => a.data.order - b.data.order)

  return sorted.map((doc, idx) => ({
    params: { slug: doc.id },
    props: {
      doc,
      prev: idx > 0 ? { slug: sorted[idx - 1].id, title: sorted[idx - 1].data.title } : null,
      next: idx < sorted.length - 1 ? { slug: sorted[idx + 1].id, title: sorted[idx + 1].data.title } : null,
    },
  }))
}

const { doc, prev, next } = Astro.props
const { Content } = await render(doc)
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
