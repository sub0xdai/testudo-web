---
import Header from '../components/Header.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'TESTUDO | Automated Risk Management for Crypto Traders',
  description = 'Automated position sizing and trade journaling for crypto perpetual futures. Size every trade correctly. Track your edge with real data.',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://testudo.vip')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      let t = localStorage.getItem('testudo-theme');
      if (t === 'soft-dark') { t = 'amoled'; localStorage.setItem('testudo-theme', t); }
      if (t && t !== 'amoled') document.documentElement.setAttribute('data-theme', t);
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- AI agent discoverability -->
    <link rel="llms" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" href="/AGENT_TRADING.md" title="Agent Trading Guide" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TESTUDO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />

    <!-- Background image -->
    <div class="fixed inset-0 z-0 overflow-hidden">
      <div
        class="absolute inset-0"
        style="background-image: url('/Roman-testudo-Trajan-column-966204074.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;"
      ></div>

      <!-- Spotlight overlay — initial dark state before first mousemove -->
      <div id="spotlight-overlay" class="absolute inset-0 pointer-events-none" style="background: rgb(var(--bg-core) / 0.93);"></div>

      <!-- Texture overlay -->
      <div id="texture-overlay" class="absolute inset-0 scan-lines"></div>
    </div>

    <slot />

    <script is:inline>
      const spotlight = document.getElementById('spotlight-overlay')
      const texture = document.getElementById('texture-overlay')
      if (spotlight) {
        const radius = 200
        function checkTheme() {
          return document.documentElement.getAttribute('data-theme') === 'light'
        }
        // Set initial texture class
        if (texture) {
          texture.className = checkTheme()
            ? 'absolute inset-0 texture-grain'
            : 'absolute inset-0 scan-lines'
        }
        document.addEventListener('mousemove', function(e) {
          var isLight = checkTheme()
          spotlight.style.background = isLight
            ? 'radial-gradient(circle ' + radius + 'px at ' + e.clientX + 'px ' + e.clientY + 'px, rgb(var(--bg-core) / 0.60) 0%, rgb(var(--bg-core) / 0.82) 70%, rgb(var(--bg-core) / 0.92) 100%)'
            : 'radial-gradient(circle ' + radius + 'px at ' + e.clientX + 'px ' + e.clientY + 'px, rgb(var(--bg-core) / 0.75) 0%, rgb(var(--bg-core) / 0.88) 70%, rgb(var(--bg-core) / 0.93) 100%)'
        })
        // Watch for theme changes to update texture overlay
        new MutationObserver(function() {
          if (texture) {
            texture.className = checkTheme()
              ? 'absolute inset-0 texture-grain'
              : 'absolute inset-0 scan-lines'
          }
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
      }
    </script>
  </body>
</html>
