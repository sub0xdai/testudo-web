---
const capabilities = [
  { label: 'RISK ENGINE', detail: 'Automated position sizing. Every trade' },
  { label: 'DEX + CEX', detail: '9 exchanges. Hyperliquid, Binance, Bybit + more' },
  { label: 'CIRCUIT BREAKERS', detail: 'Daily loss limits. Portfolio heat' },
  { label: 'EXTENSION', detail: 'Alt+X from TradingView. Instant' },
  { label: 'AI AGENTS', detail: 'Claude, Hermes, OpenClaw. Autonomous execution', href: '/AGENT_TRADING.md' },
]
---

<section class="relative z-10 px-6 md:px-12 lg:px-24 xl:px-32 pt-36 pb-20 min-h-[calc(100vh-4rem)] flex flex-col justify-center">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-12 lg:gap-32 max-w-7xl">
    <!-- Left: text content -->
    <div class="flex-1 min-w-0">
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl xl:text-9xl font-bold tracking-tight text-text-primary leading-[0.95] mb-10">
        COMMAND
        <br />
        [victōria]
      </h1>

      <p class="font-display text-lg md:text-xl text-text-primary/80 max-w-2xl mb-20 leading-relaxed">
        <br />
        Automated risk management
        <br />
      </p>

      <!-- Capabilities — containerized with semi-transparent backgrounds -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-4">
        {capabilities.map((cap) => (
          cap.href ? (
            <a href={cap.href} target="_blank" rel="noopener noreferrer" class="agent-card block border-l pl-4 py-2.5 bg-main-bg/85 backdrop-blur-sm transition-all duration-300">
              <div class="agent-card-label font-mono text-[11px] tracking-widest mb-1 font-medium">
                {cap.label}
                <span class="agent-card-arrow inline-block ml-1.5 opacity-0 -translate-x-1 transition-all duration-300 text-accent-steel">&rarr;</span>
              </div>
              <p class="font-display text-sm leading-relaxed font-medium agent-card-detail">
                {cap.detail}
              </p>
            </a>
          ) : (
            <div class="border-l border-container-border pl-4 py-2.5 bg-main-bg/85 backdrop-blur-sm">
              <div class="font-mono text-[11px] tracking-widest text-text-tertiary mb-1 font-medium">
                {cap.label}
              </div>
              <p class="font-display text-sm text-text-secondary leading-relaxed font-medium">
                {cap.detail}
              </p>
            </div>
          )
        ))}
      </div>
    </div>

    <!-- Right: crest emblem — drops in, rattles, anchored right -->
    <div class="lg:shrink-0 lg:self-center lg:ml-auto animate-land-rattle">
      <img src="/crest.png" alt="Testudo crest" class="crest-logo w-48 lg:w-72 xl:w-80" />
    </div>
  </div>
</section>

<style>
  @keyframes land-rattle {
    0% {
      opacity: 0;
      transform: translateY(-80px) rotate(-1deg);
    }
    30% {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
    38% {
      transform: translateY(0) rotate(1.5deg);
    }
    46% {
      transform: translateY(0) rotate(-1.2deg);
    }
    54% {
      transform: translateY(0) rotate(0.8deg);
    }
    62% {
      transform: translateY(0) rotate(-0.4deg);
    }
    70% {
      transform: translateY(0) rotate(0.15deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
  }

  .animate-land-rattle {
    animation: land-rattle 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.4s;
    opacity: 0;
  }

  /* Agent card — persistent glow that screams "click me" */
  .agent-card {
    border-color: rgb(var(--accent-steel) / 0.5);
    box-shadow:
      0 0 8px rgb(var(--accent-steel) / 0.15),
      0 0 20px rgb(var(--accent-steel) / 0.08),
      inset 0 0 8px rgb(var(--accent-steel) / 0.04);
    animation: agent-glow-pulse 2.5s ease-in-out infinite;
  }
  .agent-card:hover {
    border-color: rgb(var(--accent-steel) / 0.8);
    background-color: rgb(var(--accent-steel) / 0.08);
    box-shadow:
      0 0 16px rgb(var(--accent-steel) / 0.3),
      0 0 40px rgb(var(--accent-steel) / 0.15),
      0 0 60px rgb(var(--accent-steel) / 0.08),
      inset 0 0 12px rgb(var(--accent-steel) / 0.06);
  }
  .agent-card-label {
    color: rgb(var(--text-tertiary) / 1);
  }
  .agent-card:hover .agent-card-label {
    color: rgb(var(--accent-steel) / 1);
  }
  .agent-card-detail {
    color: rgb(var(--text-secondary) / 1);
  }
  .agent-card:hover .agent-card-detail {
    color: rgb(var(--text-primary) / 1);
  }
  .agent-card:hover .agent-card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes agent-glow-pulse {
    0%, 100% {
      box-shadow:
        0 0 8px rgb(var(--accent-steel) / 0.15),
        0 0 20px rgb(var(--accent-steel) / 0.08),
        inset 0 0 8px rgb(var(--accent-steel) / 0.04);
    }
    50% {
      box-shadow:
        0 0 14px rgb(var(--accent-steel) / 0.25),
        0 0 30px rgb(var(--accent-steel) / 0.14),
        inset 0 0 14px rgb(var(--accent-steel) / 0.08);
    }
  }

  /* Light theme — brighter steel hue for visibility */
  [data-theme="light"] .agent-card {
    border-color: rgb(var(--accent-steel) / 0.55);
    box-shadow:
      0 0 10px rgb(var(--accent-steel) / 0.2),
      0 0 24px rgb(var(--accent-steel) / 0.1);
    animation: agent-glow-pulse-light 2.5s ease-in-out infinite;
  }
  [data-theme="light"] .agent-card:hover {
    border-color: rgb(var(--accent-steel) / 0.8);
    background-color: rgb(var(--accent-steel) / 0.08);
    box-shadow:
      0 0 18px rgb(var(--accent-steel) / 0.35),
      0 0 44px rgb(var(--accent-steel) / 0.2);
  }

  @keyframes agent-glow-pulse-light {
    0%, 100% {
      box-shadow:
        0 0 10px rgb(var(--accent-steel) / 0.2),
        0 0 24px rgb(var(--accent-steel) / 0.1);
    }
    50% {
      box-shadow:
        0 0 16px rgb(var(--accent-steel) / 0.3),
        0 0 34px rgb(var(--accent-steel) / 0.16);
    }
  }
</style>
